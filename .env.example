# Canonical site URL for metadata.
NEXT_PUBLIC_SITE_URL=https://www.theoria.sh

# auto: Supabase when configured, otherwise labelled local seed mode.
# Use supabase in production to require the database. seed is useful for reproducible tests.
OPEN_PROBLEMS_SOURCE=auto
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Used only by npm run problems:import; not needed in Vercel or in the browser.
# A legacy service_role key can also be provided here.
SUPABASE_SECRET_KEY=
